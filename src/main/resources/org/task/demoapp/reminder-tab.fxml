<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Tab?>
<Tab xmlns="http://javafx.com/javafx/21"
     xmlns:fx="http://javafx.com/fxml/1"
     text="Reminder"
     fx:controller="org.task.demoapp.controller.ReminderController">

    <content>

        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-background-color: #f4f6f8;">

            <padding>
                <Insets top="40"
                        right="70"
                        bottom="40"
                        left="70"/>
            </padding>

            <!-- TITLE -->

            <Label text="REMINDER"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222222;"/>


            <!-- DATE -->

            <VBox spacing="8"
                  maxWidth="400">

                <Label text="Selectează data:"
                       style="-fx-font-weight: bold;"/>

                <DatePicker fx:id="reminderDatePicker"
                            prefWidth="400"/>

            </VBox>


            <!-- TIME -->

            <VBox spacing="8"
                  maxWidth="400">

                <Label text="Selectează ora:"
                       style="-fx-font-weight: bold;"/>

                <HBox spacing="10"
                      alignment="CENTER_LEFT">

                    <Spinner fx:id="reminderHourSpinner"
                             prefWidth="100"/>

                    <Label text=":"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;"/>

                    <Spinner fx:id="reminderMinuteSpinner"
                             prefWidth="100"/>

                </HBox>

            </VBox>


            <!-- COMMENT -->

            <VBox spacing="8"
                  maxWidth="400">

                <Label text="Comentariu:"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="reminderCommentField"
                           promptText="Ex: Sună-l pe profesor..."
                           prefWidth="400"/>

            </VBox>


            <!-- SCHEDULED TIME -->

            <VBox spacing="8"
                  maxWidth="400">

                <Label text="Reminder programat:"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="reminderTimeLabel"
                       text="--/--/---- --:--"
                       style="-fx-font-size: 16px;
                              -fx-text-fill: #444444;"/>

            </VBox>


            <!-- STATUS -->

            <HBox spacing="10"
                  alignment="CENTER">

                <Label text="Status:"
                       style="-fx-font-weight: bold;"/>

                <Label fx:id="reminderStatusLabel"
                       text="Ready"
                       style="-fx-text-fill: #777777;"/>

            </HBox>


            <!-- BUTTONS -->

            <HBox spacing="15"
                  alignment="CENTER">

                <Button fx:id="reminderSetButton"
                        text="SET REMINDER"
                        prefWidth="150"
                        prefHeight="45"
                        style="-fx-background-color: #2e7d32;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        onAction="#setReminder"/>

                <Button fx:id="reminderCancelButton"
                        text="CANCEL"
                        prefWidth="150"
                        prefHeight="45"
                        style="-fx-background-color: #d84315;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"
                        onAction="#cancelReminder"/>

            </HBox>

        </VBox>

    </content>

</Tab>