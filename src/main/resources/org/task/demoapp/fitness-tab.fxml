<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<Tab xmlns:fx="http://javafx.com/fxml"
     text="Fitness Timer"
     fx:controller="org.task.demoapp.controller.FitnesController">

    <VBox alignment="TOP_CENTER"
          spacing="25"
          style="-fx-background-color: #f4f6f8;">

        <padding>
            <Insets top="40" right="70" bottom="40" left="70"/>
        </padding>

        <Label text="FITNESS TIMER"
               style="-fx-text-fill: #222222;">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Label fx:id="fitnessTimerLabel"
               text="00:00:000"
               style="
                    -fx-text-fill: #222222;
                    -fx-font-weight: bold;
                    -fx-background-color: white;
                    -fx-background-radius: 20;
                    -fx-padding: 25 60 25 60;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 15, 0, 0, 4);
               ">
            <font>
                <Font size="52"/>
            </font>
        </Label>

        <HBox alignment="CENTER"
              spacing="15">

            <Button fx:id="fitnessStartButton"
                    text="START"
                    prefWidth="130"
                    prefHeight="46"
                    style="
                        -fx-background-color: #2e7d32;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
                    onAction="#start"/>

            <Button fx:id="fitnessStopButton"
                    text="STOP"
                    prefWidth="130"
                    prefHeight="46"
                    style="
                        -fx-background-color: #d84315;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
                    onAction="#stop"/>

            <Button fx:id="fitnessLapButton"
                    text="LAP"
                    prefWidth="130"
                    prefHeight="46"
                    style="
                        -fx-background-color: #1565c0;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
                    onAction="#lap"/>

        </HBox>

        <VBox spacing="15"
              maxWidth="600"
              VBox.vgrow="ALWAYS"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 20;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);
              ">

            <HBox>
                <Label text="LAPS"
                       style="
                            -fx-font-size: 18px;
                            -fx-font-weight: bold;
                       "/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lapCountLabel"
                       text="0 laps"
                       style="-fx-text-fill: #777777;"/>
            </HBox>

            <ListView fx:id="lapsListView"
                      prefHeight="230"
                      VBox.vgrow="ALWAYS"/>

        </VBox>

    </VBox>

</Tab>
