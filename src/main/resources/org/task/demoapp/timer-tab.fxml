<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory.IntegerSpinnerValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<Tab xmlns:fx="http://javafx.com/fxml"
     text="Countdown Timer"
     fx:controller="org.task.demoapp.controller.TimerController">

    <VBox alignment="TOP_CENTER"
          spacing="30"
          style="-fx-background-color: #f4f6f8;">

        <padding>
            <Insets top="40" right="70" bottom="40" left="70"/>
        </padding>

        <!-- TITLE -->
        <Label text="TIMER"
               style="-fx-text-fill: #222222;">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <!-- TIME DISPLAY -->
        <Label fx:id="timerDisplayLabel"
               text="00:00:00"
               style="
                    -fx-text-fill: #222222;
                    -fx-font-weight: bold;
                    -fx-background-color: white;
                    -fx-background-radius: 20;
                    -fx-padding: 25 60 25 60;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 15, 0, 0, 4);
               ">
            <font>
                <Font size="54"/>
            </font>
        </Label>

        <!-- DURATION SETUP CARD -->
        <VBox spacing="18"
              alignment="CENTER"
              maxWidth="650"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 25;
                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);
              ">

            <Label text="Set Duration"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Choose hours, minutes and seconds before starting"
                   style="-fx-text-fill: #777777;"/>

            <HBox alignment="CENTER" spacing="25">

                <VBox alignment="CENTER" spacing="6">
                    <Label text="HOURS" style="-fx-text-fill: #777777; -fx-font-weight: bold;"/>
                    <Spinner fx:id="hoursSpinner" prefWidth="90" editable="true">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory
                                    min="0"
                                    max="3600"
                                    initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </VBox>

                <VBox alignment="CENTER" spacing="6">
                    <Label text="MINUTES" style="-fx-text-fill: #777777; -fx-font-weight: bold;"/>
                    <Spinner fx:id="minutesSpinner" prefWidth="90" editable="true">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory
                                    min="0"
                                    max="59"
                                    initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </VBox>

                <VBox alignment="CENTER" spacing="6">
                    <Label text="SECONDS" style="-fx-text-fill: #777777; -fx-font-weight: bold;"/>
                    <Spinner fx:id="secondsSpinner" prefWidth="90" editable="true">
                        <valueFactory>
                            <SpinnerValueFactory.IntegerSpinnerValueFactory
                                    min="0"
                                    max="59"
                                    initialValue="0"/>
                        </valueFactory>
                    </Spinner>
                </VBox>

            </HBox>

            <ProgressBar fx:id="timerProgressBar"
                         prefWidth="580"
                         progress="0.0"/>

        </VBox>

        <Label fx:id="timerStateLabel"
               text="Ready"
               style="
                    -fx-font-size: 16px;
                    -fx-text-fill: #777777;
               "/>

        <HBox alignment="CENTER"
              spacing="20">

            <Button fx:id="timerStartButton"
                    text="START"
                    prefWidth="140"
                    prefHeight="48"
                    style="
                        -fx-background-color: #2e7d32;
                        -fx-text-fill: white;
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
            onAction="#startTimer"/>

            <Button fx:id="timerPauseButton"
                    text="PAUSE"
                    prefWidth="140"
                    prefHeight="48"
                    style="
                        -fx-background-color: #1565c0;
                        -fx-text-fill: white;
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
                    onAction="#pauseTimer"
            />


            <Button fx:id="timerResetButton"
                    text="RESET"
                    prefWidth="140"
                    prefHeight="48"
                    style="
                        -fx-background-color: #d84315;
                        -fx-text-fill: white;
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                        -fx-cursor: hand;
                    "
                    onAction="#resetTimer"
            />

        </HBox>

    </VBox>

</Tab>
